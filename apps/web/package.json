{
  "name": "@fbmaniaco/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node ../../node_modules/vite/bin/vite.js build",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "lint": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "dev": "node ../../node_modules/vite/bin/vite.js --host 0.0.0.0"
  },
  "dependencies": {
    "@fbmaniaco/shared": "workspace:*",
    "@journeyapps/wa-sqlite": "^1.0.6",
    "@powersync/web": "^1.35.1",
    "@sentry/browser": "^10.53.1",
    "@supabase/supabase-js": "^2.47.10",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
