{
  "name": "@cadencia/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm --workspace @cadencia/shared run build && tsc -p tsconfig.json",
    "dev": "npm --workspace @cadencia/shared run build && tsx watch src/index.ts",
    "lint": "eslint src --ext .ts",
    "start": "node dist/index.js",
    "typecheck": "npm --workspace @cadencia/shared run build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cadencia/shared": "file:../shared",
    "@supabase/supabase-js": "^2.50.0",
    "@types/pg": "^8.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "pg": "^8.21.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
